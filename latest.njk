---
permalink: /latest.json
eleventyExcludeFromCollections: true
---
{#- Machine-readable manifest of the newest insights, consumed at build time by
    the main TBI KSA site (web/site/_data/insights.js) to render its
    "From TBI Research" band. Newest first, capped at 6. dump = JSON-safe. -#}
[
{%- for item in collections.allInsights -%}
{%- if loop.index0 < 6 %}
  {
    "title": {{ item.data.title | dump | safe }},
    "summary": {{ (item.data.summary or "") | dump | safe }},
    "type": {{ item.data.type | dump | safe }},
    "typeLabel": {{ item.data.typeLabel | dump | safe }},
    "date": {{ (item.data.date | readableDate) | dump | safe }},
    "url": {{ ("https://tbi-ksa.github.io/insights" + item.url) | dump | safe }}
  }{% if not loop.last and loop.index0 < 5 %},{% endif %}
{%- endif -%}
{%- endfor %}
]
